{
  "name": "@codetranslate/hosted",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "prisma generate && tsc --noEmit -p tsconfig.json",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "prisma": "prisma",
    "test": "echo \"tested from workspace root\""
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@codetranslate/application": "workspace:*",
    "@codetranslate/core": "workspace:*",
    "@codetranslate/ingest": "workspace:*",
    "@codetranslate/shared": "workspace:*",
    "@prisma/client": "^6.16.2",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "prisma": "^6.16.2",
    "typescript": "^5.8.2"
  }
}
