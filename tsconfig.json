{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@codetranslate/shared": ["packages/shared/src/index.ts"],
      "@codetranslate/core": ["packages/core/src/index.ts"],
      "@codetranslate/ingest": ["packages/ingest/src/index.ts"],
      "@codetranslate/parser": ["packages/parser/src/index.ts"]
    }
  },
  "include": [
    "apps/*/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.d.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**", "fixtures/**"]
}
