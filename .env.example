# Open-source local mode (default)
# Leave HOSTED_MODE unset and run: pnpm web

# Hosted mode
HOSTED_MODE=true
DATABASE_URL=postgresql://codetranslate:codetranslate@localhost:5432/codetranslate
AUTH_SECRET=replace-with-a-long-random-string
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional GitHub App (read-only repository access)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=

# Optional
# AUTH_URL=http://localhost:3000
# OPEN_SOURCE_REPO_URL=https://github.com/noobhanz/code-translator
